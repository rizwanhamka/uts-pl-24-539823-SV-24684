{
  "info": {
    "name": "UTS PL - Buku API",
    "description": "RESTful API Perpustakaan Mini (Laravel + Sanctum). Jalankan request secara berurutan, mulai dari Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" },
    { "key": "buku_id", "value": "" },
    { "key": "admin_email", "value": "admin@example.com" },
    { "key": "admin_password", "value": "megamode12" }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Balasan berisi token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      }
    },
    {
      "name": "2. Tampil semua buku",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('data berupa array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      }
    },
    {
      "name": "3. Tanpa token (harus 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401 saat token tidak ada', () => pm.response.to.have.status(401));",
              "pm.test('Balasan berformat JSON', () => pm.expect(pm.response.json()).to.have.property('message'));"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      }
    },
    {
      "name": "4. Tambah buku (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 saat data dibuat', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Data tersimpan dan punya id', () => pm.expect(json.data.id).to.be.a('number'));",
              "pm.collectionVariables.set('buku_id', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Pemrograman Laravel\",\n  \"penulis\": \"Ahmad Rizwan Hamka\",\n  \"tahun_terbit\": 2024,\n  \"stok\": 10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      }
    },
    {
      "name": "5. Tambah buku tidak valid (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422 saat validasi gagal', () => pm.response.to.have.status(422));",
              "const errors = pm.response.json().errors;",
              "pm.test('Error validasi memuat semua field', () => {",
              "  pm.expect(errors).to.have.all.keys('judul', 'penulis', 'tahun_terbit', 'stok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      }
    },
    {
      "name": "6. Tampil satu buku",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('id sesuai yang diminta', () => {",
              "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('buku_id')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/buku/{{buku_id}}",
          "host": ["{{base_url}}"],
          "path": ["buku", "{{buku_id}}"]
        }
      }
    },
    {
      "name": "7. Ubah buku",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Judul berubah', () => {",
              "  pm.expect(pm.response.json().data.judul).to.eql('Pemrograman Laravel (Edisi Revisi)');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Pemrograman Laravel (Edisi Revisi)\",\n  \"penulis\": \"Ahmad Rizwan Hamka\",\n  \"tahun_terbit\": 2025,\n  \"stok\": 15\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/buku/{{buku_id}}",
          "host": ["{{base_url}}"],
          "path": ["buku", "{{buku_id}}"]
        }
      }
    },
    {
      "name": "8. Hapus buku",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Ada pesan konfirmasi', () => pm.expect(pm.response.json()).to.have.property('message'));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/buku/{{buku_id}}",
          "host": ["{{base_url}}"],
          "path": ["buku", "{{buku_id}}"]
        }
      }
    },
    {
      "name": "9. Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset('token');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/logout",
          "host": ["{{base_url}}"],
          "path": ["logout"]
        }
      }
    }
  ]
}
