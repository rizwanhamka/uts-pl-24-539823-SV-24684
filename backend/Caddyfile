{
	frankenphp

	servers :8000 {
		name app
		metrics
	}
}

:8000 {
	root * public/
	encode zstd br gzip

	log {
		output stdout
		format console
	}

	php_server
}

# Endpoint metrik untuk Prometheus.
# Port ini TIDAK dipublikasikan ke host, hanya terjangkau di jaringan Docker Compose.
:9180 {
	metrics /metrics
}
